# GEMINI_API_KEY: Required for Gemini AI API calls (deferred — not used in current build).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Formspree form ID for the contact form (get yours at https://formspree.io)
VITE_FORMSPREE_ID=your_form_id
